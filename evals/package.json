    },
    "dependencies": {
        "neverthrow": "8.2.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "oxlint": "1.85.0",
        "prettier": "^3.9.5",
        "@typescript/native": "npm:typescript@7.0.2"
    }
}
