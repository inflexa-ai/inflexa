{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/test",
    "src/**/__tests__",
    "src/**/__fixtures__",
    "src/report-render/fixture.ts",
    "src/report-render/gallery"
  ]
}
