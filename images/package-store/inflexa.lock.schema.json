{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inflexa.ai/schemas/inflexa.lock.v1.json",
  "title": "inflexa.lock",
  "description": "The one metadata file of a farm, at schema version 1. The mount gate of the harness and the package inventory read this file. The zod shape in harness/src/sandbox/farm.ts validates the same contract.",
  "type": "object",
  "required": ["schema", "arch", "packages", "languages"],
  "properties": {
    "schema": { "const": 1 },
    "arch": { "enum": ["amd64", "arm64"] },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "track", "store_dir", "hash", "requested"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "track": {
            "type": "string",
            "description": "The subtree of the links of the package, for example python, cran, bioconductor, or github."
          },
          "store_dir": { "type": "string", "minLength": 1 },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The full sha256 of the sorted store tree."
          },
          "requested": {
            "type": "boolean",
            "description": "The PEP 376 meaning: true for a direct ask, false for a transitive dependency."
          }
        }
      }
    },
    "languages": {
      "type": "object",
      "description": "The per-language provenance. Each language object owns its own fields.",
      "properties": {
        "python": {
          "type": "object",
          "required": ["version", "index"],
          "properties": {
            "version": { "type": "string" },
            "index": { "type": "string" }
          }
        },
        "r": {
          "type": "object",
          "required": ["version", "bioc_releases"],
          "properties": {
            "version": { "type": "string" },
            "bioc_releases": { "type": "array", "items": { "type": "string" } },
            "pak_lock": {
              "description": "The embedded pak lock of the build, verbatim."
            }
          }
        }
      }
    },
    "warm": {
      "type": "object",
      "description": "The replay record of the preparation run. Present in the catalog farm only: per package, the hash of its warm script and the cache entries the workload reuses.",
      "additionalProperties": {
        "type": "object",
        "required": ["script_sha256", "cache_entries"],
        "properties": {
          "script_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "cache_entries": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "merge_conflicts": {
      "type": "array",
      "description": "The top-level entries that the link merge kept-first or skipped.",
      "items": {
        "type": "object",
        "required": ["entry", "action"],
        "properties": {
          "entry": { "type": "string" },
          "action": { "enum": ["kept-first", "skipped"] }
        }
      }
    }
  }
}
