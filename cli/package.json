{
    "name": "inflexa",
    "version": "0.25.1",
    "description": "Local-first AI agent for reproducible biological data analysis",
    "keywords": [
        "bioinformatics",
        "computational-biology",
        "ai-agent",
        "agentic-ai",
        "genomics",
        "multi-omics",
        "rna-seq",
        "single-cell",
        "reproducible-research",
        "provenance",
        "local-first",
        "llm"
    ],
    "homepage": "https://inflexa.ai",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun scripts/build.ts",
        "build:all": "bun scripts/build.ts --all",
        "dev": "NODE_USE_SYSTEM_CA=1 bun run src/index.ts",
        "dev:install": "bun scripts/dev_install.ts",
        "docs:gen": "bun scripts/gen_docs.ts",
        "dupes": "jscpd src scripts --exit-code --fail-on-empty",
        "format": "prettier --write src/",
        "format:file": "prettier --write",
        "harness:local": "cd ../harness && bun run build && cd ../cli && rm -rf node_modules/@inflexa-ai/harness && ln -s ../../../harness node_modules/@inflexa-ai/harness",
        "harness:remote": "rm -rf node_modules/@inflexa-ai/harness && bun install",
        "kernel:local": "cd ../prov-kernel && bun run build && cd ../cli && rm -rf node_modules/@inflexa-ai/prov-kernel && ln -s ../../../prov-kernel node_modules/@inflexa-ai/prov-kernel && rm -rf ../prov-kernel/node_modules/@inflexa-ai/tsprov && ln -s \"$(pwd)/node_modules/@inflexa-ai/tsprov\" ../prov-kernel/node_modules/@inflexa-ai/tsprov",
        "kernel:remote": "rm -rf node_modules/@inflexa-ai/prov-kernel ../prov-kernel/node_modules/@inflexa-ai/tsprov && bun install && bun install --cwd ../prov-kernel",
        "lint": "bun --bun oxlint",
        "start": "bun run src/index.ts",
        "test": "bun test",
        "typecheck": "inflexa-typecheck",
        "wipe": "bun scripts/wipe.ts"
    },
    "dependencies": {
        "@clack/core": "1.4.3",
        "@clack/prompts": "^1.7.0",
        "@inflexa-ai/harness": "^0.48.5",
        "@inflexa-ai/prov-kernel": "^0.8.0",
        "@inflexa-ai/tsprov": "0.5.1",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/api-logs": "^0.219.0",
        "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
        "@opentelemetry/resources": "^2.9.0",
        "@opentelemetry/sdk-logs": "^0.219.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@opentui/core": "0.4.2",
        "@opentui/solid": "0.4.2",
        "commander": "^15",
        "hono": "^4.12.34",
        "linguist-languages": "^9.5.0",
        "neverthrow": "^8.2.0",
        "p-queue": "^9.3.3",
        "pino": "^10.3.1",
        "solid-js": "^1.9.14",
        "zod": "^4.4.3"
    },
    "overrides": {
        "@babel/core": "^7.29.6",
        "fast-xml-parser": "^5.10.1",
        "hono": "^4.12.34",
        "ip-address": "^10.3.1",
        "js-yaml": "^4.3.1",
        "protobufjs": "^7.6.5",
        "undici": "^7.29.0",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@inflexa-ai/oxlint-plugin": "0.8.0",
        "@inflexa-ai/oxlint-plugin-solid": "0.8.0",
        "@inflexa-ai/typecheck": "0.8.0",
        "@types/bun": "latest",
        "@types/luxon": "^3.7.6",
        "@types/node": "^26.1.1",
        "@typescript/native": "npm:typescript@7.0.2",
        "jscpd": "5.4.2",
        "oxlint": "1.85.0",
        "oxlint-tsgolint": "7.0.2003",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript": "^6.0.3"
    }
}
