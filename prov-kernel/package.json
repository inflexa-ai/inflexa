{
    "name": "@inflexa-ai/prov-kernel",
    "version": "0.7.1",
    "description": "Inflexa provenance format kernel — the PROV dialect document model, the lineage read model, chain-hash + Ed25519 signing, and the signed-attestation schema.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./*.js": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "dist",
        "NOTICE",
        "SPEC.md"
    ],
    "engines": {
        "node": ">=24"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/inflexa-ai/inflexa.git",
        "directory": "prov-kernel"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "format": "prettier --write src/",
        "format:file": "prettier --write",
        "lint": "bun --bun oxlint",
        "prepare": "tsc -p tsconfig.build.json",
        "prepublishOnly": "bun run build && bun run smoke",
        "smoke": "node scripts/smoke.mjs",
        "typecheck": "inflexa-typecheck"
    },
    "dependencies": {
        "@noble/hashes": "^2.3.0",
        "neverthrow": "^8.2.0",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "@inflexa-ai/tsprov": "^0.5.1"
    },
    "devDependencies": {
        "@inflexa-ai/oxlint-plugin": "0.7.0",
        "@inflexa-ai/tsprov": "^0.5.1",
        "@inflexa-ai/typecheck": "0.7.0",
        "@types/bun": "latest",
        "@types/luxon": "^3.7.6",
        "@types/node": "^24.13.3",
        "@typescript/native": "npm:typescript@7.0.2",
        "oxlint": "1.85.0",
        "oxlint-tsgolint": "7.0.2003",
        "prettier": "^3.9.5",
        "typescript": "^6.0.3"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
