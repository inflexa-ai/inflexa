{
    "name": "@inflexa-ai/knowledge",
    "version": "0.1.0",
    "private": true,
    "description": "The Inflexa knowledge plane: the knowledge as code, the snapshot build, the typed service, and the Phase 0 evaluation.",
    "license": "UNLICENSED",
    "type": "module",
    "engines": {
        "bun": ">=1.3"
    },
    "scripts": {
        "build": "bun src/build/build-snapshot.ts",
        "validate": "bun src/build/validate.ts",
        "validate:linkml": "bash scripts/linkml-gate.sh",
        "serve": "bun src/service/main.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "templates:test": "bun src/build/template-tests.ts",
        "eval:simulate": "bun eval/src/simulate.ts",
        "eval:run": "bun eval/src/run.ts",
        "eval:report": "bun eval/src/report.ts"
    },
    "dependencies": {
        "pg": "^8.16.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bun": "^1.3.0",
        "@types/pg": "^8.15.0",
        "typescript": "^5.9.0"
    }
}
