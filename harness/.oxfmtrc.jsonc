{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 160,
  "tabWidth": 4,
  "sortPackageJson": false,
  // oxfmt reads .gitignore too, so dist and node_modules are absent here.
  // These are tracked but still must not be reformatted.
  "ignorePatterns": [
    // Hand-maintained data corpora: large, edited by hand, and noisy in a diff.
    "src/data/",
    // Byte-locked cross-repo test vectors: exact copies of the testdata files of
    // kernel/contenttoken in the storage backend.
    "src/__tests__/fixtures/preview-res.json",
    "src/__tests__/fixtures/report-session-res.json",
    // Golden payloads of the external APIs, plus their published-schema oracles.
    // `scripts/refresh-fixtures.ts` writes and diffs these files, and a reformat
    // reports as drift on the next replay. The manifest and the runner are source.
    "src/tools/lib/__fixtures__/*/",
    // `derive/thin_gallery.py` writes the gallery tables and their manifest, and the
    // manifest states the byte count of each table.
    "src/report-render/gallery/data/",
    "src/report-render/gallery/manifest.json",
  ],
}
